<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>P.E.L.E — Proactive SOC + GRC Framework</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css">
<style>
  :root {
    --sidebar: #1e2822;
    --sidebar-active: #2d3d32;
    --green-dark: #1a5c3a;
    --green-mid: #2d9e6b;
    --green-light: #4cbe8a;
    --green-pale: #e0f2ea;
    --charcoal: #2b2f2b;
    --charcoal-light: #3c413c;
    --white: #ffffff;
    --bg: #f0f4f1;
    --card: #ffffff;
    --text-primary: #1a1f1a;
    --text-secondary: #5a6b5a;
    --text-muted: #8fa08f;
    --border: #e0eae0;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text-primary);
    display: flex;
    min-height: 100vh;
  }

  /* SIDEBAR */
  .sidebar {
    width: 240px; min-width: 240px;
    background: var(--sidebar);
    display: flex; flex-direction: column;
    padding: 28px 0;
    position: fixed; top: 0; left: 0; bottom: 0;
    z-index: 10; overflow-y: auto;
  }

  .profile {
    display: flex; flex-direction: column; align-items: center;
    padding: 0 20px 24px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .avatar-wrap {
    width: 72px; height: 72px; border-radius: 50%;
    border: 2.5px solid var(--green-mid); overflow: hidden;
    margin-bottom: 12px; background: var(--green-dark);
    display: flex; align-items: center; justify-content: center;
  }

  .profile-name { font-size: 15px; font-weight: 600; color: #fff; text-align: center; }
  .profile-role { font-size: 11px; color: var(--green-light); text-align: center; margin-top: 3px; letter-spacing: 0.4px; }

  .nav { flex: 1; padding: 16px 0; }

  .nav-section {
    font-size: 9px; letter-spacing: 2px; color: rgba(255,255,255,0.25);
    padding: 12px 24px 5px; text-transform: uppercase;
  }

  .nav-item {
    display: flex; align-items: center; gap: 12px;
    padding: 11px 24px; font-size: 13px;
    color: rgba(255,255,255,0.55); cursor: pointer;
    transition: all 0.15s; letter-spacing: 0.3px;
    border-left: 3px solid transparent;
  }

  .nav-item i { font-size: 18px; }
  .nav-item:hover { color: #fff; background: rgba(255,255,255,0.05); }
  .nav-item.active { color: #fff; background: var(--sidebar-active); border-left-color: var(--green-light); padding-left: 21px; }

  .sidebar-footer {
    padding: 20px 20px 0;
    border-top: 1px solid rgba(255,255,255,0.07);
  }

  .active-users-label {
    font-size: 10px; letter-spacing: 1.5px;
    color: var(--green-light); text-transform: uppercase; margin-bottom: 10px;
  }

  .avatar-stack { display: flex; align-items: center; }

  .mini-av {
    width: 28px; height: 28px; border-radius: 50%;
    border: 2px solid var(--sidebar); margin-left: -6px;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 600; color: #fff;
  }

  .mini-av:first-child { margin-left: 0; }

  .av-count {
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--green-mid); border: 2px solid var(--sidebar);
    margin-left: -6px; display: flex; align-items: center;
    justify-content: center; font-size: 9px; font-weight: 700; color: #fff;
  }

  .world-map { margin-top: 14px; opacity: 0.25; width: 100%; }

  /* MAIN */
  .main { margin-left: 240px; flex: 1; padding: 28px; min-height: 100vh; }

  .topbar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 22px;
  }

  .page-title { font-size: 20px; font-weight: 600; color: var(--text-primary); }
  .page-sub { font-size: 12px; color: var(--text-muted); margin-top: 2px; }

  .status-pill {
    display: flex; align-items: center; gap: 6px;
    background: var(--green-pale); border-radius: 20px;
    padding: 6px 14px; font-size: 12px; font-weight: 500; color: var(--green-dark);
  }

  .pulse {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--green-mid);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

  /* STAT CARDS */
  .stat-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; margin-bottom: 18px; }

  .stat-card {
    border-radius: 14px; padding: 18px 20px;
    display: flex; align-items: center; justify-content: space-between;
    position: relative; overflow: hidden;
  }

  .sc1 { background: var(--green-dark); }
  .sc2 { background: var(--charcoal); }
  .sc3 { background: var(--green-mid); }

  .sc-label { font-size: 11px; color: rgba(255,255,255,0.6); letter-spacing: 0.5px; margin-bottom: 5px; }
  .sc-val { font-family: 'Space Mono', monospace; font-size: 26px; font-weight: 700; color: #fff; line-height: 1; }
  .sc-delta { font-size: 11px; color: rgba(255,255,255,0.45); margin-top: 5px; }

  .sc-icon {
    width: 50px; height: 50px; background: rgba(255,255,255,0.1);
    border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }

  .sc-icon i { font-size: 24px; color: rgba(255,255,255,0.8); }
  .sc-bg { position:absolute; right:-10px; top:-10px; width:80px; height:80px; border-radius:50%; background:rgba(255,255,255,0.04); }

  /* GRID ROWS */
  .row { display: grid; gap: 14px; margin-bottom: 18px; }
  .row-32 { grid-template-columns: 1.5fr 1fr; }
  .row-half { grid-template-columns: 1fr 1fr; }

  /* CARD */
  .card { background: var(--card); border-radius: 14px; padding: 20px; border: 1px solid var(--border); }

  .card-hdr { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px; }
  .card-title { font-size: 14px; font-weight: 600; color: var(--text-primary); }
  .card-sub-text { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

  .badge {
    font-size: 10px; padding: 3px 10px; border-radius: 20px;
    font-weight: 500; background: var(--green-pale); color: var(--green-dark); white-space: nowrap;
  }

  /* ALERT TABLE */
  .atbl { width: 100%; border-collapse: collapse; }
  .atbl th { font-size: 10px; letter-spacing: 1px; color: var(--text-muted); text-transform: uppercase; text-align: left; padding: 0 0 10px; border-bottom: 1px solid var(--border); font-weight: 500; }
  .atbl td { padding: 11px 0; border-bottom: 1px solid var(--border); font-size: 13px; vertical-align: middle; }
  .atbl tr:last-child td { border-bottom: none; }

  .sev { display:inline-block; font-size:9px; font-weight:700; padding:3px 8px; border-radius:4px; font-family:'Space Mono',monospace; letter-spacing:0.5px; }
  .s-crit { background:#fde8e8; color:#9b1c1c; }
  .s-high { background:#fef3c7; color:#92400e; }
  .s-med { background:var(--green-pale); color:var(--green-dark); }

  .a-name { color:var(--text-primary); }
  .a-time { font-family:'Space Mono',monospace; font-size:11px; color:var(--text-muted); }
  .a-src { font-size:12px; color:var(--text-muted); }

  /* COMPLIANCE */
  .comp-item { margin-bottom: 13px; }
  .comp-item:last-child { margin-bottom: 0; }
  .comp-hdr { display:flex; justify-content:space-between; font-size:12px; margin-bottom:5px; }
  .comp-label { color:var(--text-secondary); }
  .comp-pct { font-family:'Space Mono',monospace; font-weight:700; color:var(--text-primary); }
  .bar-track { height:6px; background:var(--green-pale); border-radius:3px; overflow:hidden; }
  .bar-fill { height:100%; border-radius:3px; transition:width 1s cubic-bezier(0.4,0,0.2,1); }
  .f1{background:var(--green-dark)} .f2{background:var(--green-mid)} .f3{background:var(--green-light)} .f4{background:#7dcba8}

  /* RISK */
  .risk-row { display:flex; align-items:center; gap:10px; padding:9px 0; border-bottom:1px solid var(--border); font-size:13px; }
  .risk-row:last-child { border-bottom:none; }
  .r-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
  .dr{background:#e24b4a} .da{background:#f5a623} .dg{background:var(--green-mid)}
  .r-name { flex:1; color:var(--text-primary); }
  .r-score { font-family:'Space Mono',monospace; font-size:12px; color:var(--text-muted); }

  /* DONUT */
  .donut-wrap { display:flex; align-items:center; justify-content:center; gap:20px; }
  .donut-legend { display:flex; flex-direction:column; gap:8px; }
  .leg-item { display:flex; align-items:center; gap:8px; font-size:12px; color:var(--text-secondary); }
  .leg-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; }

  /* BAR CHART */
  .bar-chart { display:flex; align-items:flex-end; gap:8px; height:90px; margin-top:8px; }
  .bar-grp { display:flex; flex-direction:column; align-items:center; gap:4px; flex:1; }
  .bars { display:flex; gap:3px; align-items:flex-end; height:70px; }
  .bc { width:9px; border-radius:3px 3px 0 0; }
  .ba{background:var(--green-dark)} .bb{background:var(--green-light)}
  .b-mo { font-size:10px; color:var(--text-muted); }

  /* IR */
  .ir-phases { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:14px; }
  .ir-phase { background:var(--green-pale); border-radius:10px; padding:13px 8px; text-align:center; cursor:pointer; border:1.5px solid transparent; transition:all 0.15s; }
  .ir-phase:hover,.ir-phase.active { border-color:var(--green-mid); background:#fff; box-shadow:0 2px 12px rgba(45,158,107,0.12); }
  .ir-phase i { font-size:20px; color:var(--green-dark); display:block; margin-bottom:5px; }
  .ir-num { font-size:9px; color:var(--text-muted); font-family:'Space Mono',monospace; margin-bottom:2px; }
  .ir-name { font-size:11px; font-weight:600; color:var(--text-primary); text-transform:uppercase; letter-spacing:0.5px; }

  /* CHECKLIST */
  .chk { display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--border); font-size:13px; cursor:pointer; }
  .chk:last-child { border-bottom:none; }
  .chk.done { color:var(--text-muted); text-decoration:line-through; }
  .chk-circle { width:18px; height:18px; border-radius:50%; border:1.5px solid var(--border); display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:all 0.15s; }
  .chk.done .chk-circle { background:var(--green-mid); border-color:var(--green-mid); }
  .chk-circle i { font-size:10px; color:#fff; display:none; }
  .chk.done .chk-circle i { display:block; }

  /* ABOUT */
  .about-text { font-size:12px; color:var(--text-secondary); line-height:1.7; margin-bottom:12px; }
  .tag-row { display:flex; gap:6px; flex-wrap:wrap; }

  ::-webkit-scrollbar { width:5px; }
  ::-webkit-scrollbar-thumb { background:var(--border); border-radius:3px; }
</style>
</head>
<body>

