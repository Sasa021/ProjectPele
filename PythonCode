  <!-- ROW 3 -->
  <div class="row row-32">
    <div class="card">
      <div class="card-hdr"><div><div class="card-title">Incident Response Phases</div><div class="card-sub-text">Select a phase to view checklist</div></div></div>
      <div class="ir-phases">
        <div class="ir-phase active" onclick="selectPhase(0,this)"><i class="ti ti-settings"></i><div class="ir-num">01</div><div class="ir-name">Prep</div></div>
        <div class="ir-phase" onclick="selectPhase(1,this)"><i class="ti ti-eye"></i><div class="ir-num">02</div><div class="ir-name">Detect</div></div>
        <div class="ir-phase" onclick="selectPhase(2,this)"><i class="ti ti-lock"></i><div class="ir-num">03</div><div class="ir-name">Contain</div></div>
        <div class="ir-phase" onclick="selectPhase(3,this)"><i class="ti ti-heart-rate-monitor"></i><div class="ir-num">04</div><div class="ir-name">Recover</div></div>
      </div>
      <div id="checklist"></div>
    </div>

    <div class="card">
      <div class="card-hdr"><div><div class="card-title">Upcoming Obligations</div><div class="card-sub-text">Compliance calendar</div></div></div>
      <div class="risk-row"><span class="sev s-crit" style="font-size:9px;white-space:nowrap">14 days</span><span class="r-name" style="margin-left:8px">ISO 27001 surveillance audit</span></div>
      <div class="risk-row"><span class="sev s-high" style="font-size:9px;white-space:nowrap">32 days</span><span class="r-name" style="margin-left:8px">POPIA breach notification drill</span></div>
      <div class="risk-row"><span class="sev s-med" style="font-size:9px;white-space:nowrap">60 days</span><span class="r-name" style="margin-left:8px">Quarterly vendor risk reviews</span></div>

      <div style="margin-top:18px">
        <div class="card-title" style="font-size:13px;margin-bottom:10px">About the Author</div>
        <div class="about-text">Microsoft Certified Security Operations Analyst with experience across cybersecurity, GRC, policy, and strategic communications. Currently studying Political Science and Industrial Psychology at UWC. Based in Cape Town, South Africa.</div>
        <div class="tag-row">
          <span class="badge">MWR CyberSec</span>
          <span class="badge">UWC</span>
          <span class="badge">Y20 G20</span>
          <span class="badge">Silulo Foundation</span>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
const phases = [
  { items:[{t:"IRP documented and version-controlled",done:true},{t:"SIEM playbooks reviewed and updated",done:true},{t:"On-call rota and escalation matrix confirmed",done:true},{t:"Tabletop exercise completed this quarter",done:false},{t:"Threat intelligence feeds integrated",done:false}] },
  { items:[{t:"Alert triaged and severity assigned",done:false},{t:"IOCs extracted and cross-referenced",done:false},{t:"Affected assets and blast radius identified",done:false},{t:"Initial stakeholder notification sent",done:false},{t:"Evidence preserved — log capture initiated",done:false}] },
  { items:[{t:"Short-term containment applied (network isolation)",done:false},{t:"Compromised credentials rotated",done:false},{t:"Forensic image captured before remediation",done:false},{t:"Long-term containment strategy approved",done:false},{t:"Communication to affected teams dispatched",done:false}] },
  { items:[{t:"Systems restored from verified clean backup",done:false},{t:"Patch or fix validated in staging",done:false},{t:"Monitoring intensified post-restoration",done:false},{t:"Post-incident review scheduled",done:false},{t:"Lessons learned documented in ITSM",done:false}] }
];

let cur = 0;
let states = phases.map(p => p.items.map(i => i.done));

function render() {
  document.getElementById('checklist').innerHTML = states[cur].map((done,i) =>
    `<div class="chk${done?' done':''}" onclick="toggle(${i})">
      <div class="chk-circle"><i class="ti ti-check"></i></div>
      <span>${phases[cur].items[i].t}</span>
    </div>`
  ).join('');
}

function toggle(i) { states[cur][i] = !states[cur][i]; render(); }

function selectPhase(n, el) {
  document.querySelectorAll('.ir-phase').forEach(e => e.classList.remove('active'));
  el.classList.add('active'); cur = n; render();
}

function setNav(el) {
  document.querySelectorAll('.nav-item').forEach(e => e.classList.remove('active'));
  el.classList.add('active');
}

render();
</script>
</body>
</html>
